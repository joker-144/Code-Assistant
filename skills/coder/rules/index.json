{
  "languages": ["typescript", "python", "go", "javascript", "rust", "java"],
  "frameworks": ["react", "vue", "nextjs", "nuxt", "django", "spring-boot"],
  "priority": {
    "user_custom": 100,
    "custom_rules": 90,
    "framework": 80,
    "language": 70,
    "default": 60
  },
  "detection_rules": {
    "typescript": { "files": ["tsconfig.json"], "extensions": [".ts", ".tsx"] },
    "python": { "files": ["requirements.txt", "pyproject.toml"], "extensions": [".py"] },
    "go": { "files": ["go.mod"], "extensions": [".go"] },
    "javascript": { "files": ["package.json"], "extensions": [".js", ".jsx"] },
    "rust": { "files": ["Cargo.toml"], "extensions": [".rs"] },
    "java": { "files": ["pom.xml", "build.gradle"], "extensions": [".java"] }
  }
}
